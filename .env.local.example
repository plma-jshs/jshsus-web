COMPOSE_ENV_FILE=.env.local
NODE_ENV=development
TZ=Asia/Seoul
API_PORT=4000
WEB_PORT=5173
ADMIN_PORT=5174
# Optional public GA4 measurement ID for local analytics testing.
VITE_GA_MEASUREMENT_ID=
API_ORIGIN=http://localhost:4000
API_BASE_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SSO_PUBLIC_ORIGIN=http://localhost:5174
SSO_WEB_ORIGINS=http://localhost:5173
SSO_ADMIN_ORIGINS=http://localhost:5174

MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379
MYSQL_VOLUME_NAME=jshsus-local-admin-mysql-data
MYSQL_USER=jshs_web
MYSQL_PASSWORD=local_mysql_password
MYSQL_ROOT_PASSWORD=local_mysql_root_password
COMPOSE_DATABASE_URL=mysql://jshs_web:local_mysql_password@mysql:3306/jshsus
DATABASE_URL=mysql://jshs_web:local_mysql_password@localhost:3307/jshsus
BOOTSTRAP_LEGACY_CONTENT=true
MIGRATION_DATABASE_URL=mysql://jshs_web:local_mysql_password@localhost:3307/jshsus
DATABASE_SSL_MODE=disabled

ALLOW_LOCAL_SEED=true
DEV_AUTH_BYPASS=true
DEV_AUTH_STUDENT_NO=9999
TEST_USER_STUDENT_NO=9999
TEST_USER_NAME=테스트
TEST_USER_GRADE=3
TEST_USER_CLASS_NO=9
TEST_USER_NUMBER=99

REDIS_PASSWORD=local_redis_password
REDIS_URL=redis://:local_redis_password@localhost:6379/0
SESSION_COOKIE_DOMAIN=localhost
SESSION_COOKIE_HOST_ONLY=false
SESSION_COOKIE_SECURE=false
CSRF_SECRET=local-development-csrf-secret-change-me
CSRF_COOKIE_NAME=jshsus.csrf
AUTH_MODE=cognito

# The local flow never calls Cognito. Keep provider credentials empty.
COGNITO_REGION=ap-northeast-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_WEB_CLIENT_ID=
COGNITO_WEB_CLIENT_SECRET=
COGNITO_ADMIN_CLIENT_ID=
COGNITO_ADMIN_CLIENT_SECRET=
COGNITO_AWS_ACCESS_KEY_ID=
COGNITO_AWS_SECRET_ACCESS_KEY=
ACCOUNT_ACTIVATION_CODE_TTL_DAYS=30

AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
FILE_UPLOAD_MAX_MB=10
FILE_USER_STORAGE_QUOTA_MB=1024
FILE_MANAGER_STORAGE_QUOTA_MB=1024
FILE_PRESIGNED_URL_TTL_SECONDS=300
YOUTUBE_API_KEY=
