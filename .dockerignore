**/node_modules
**/dist
**/.turbo
.git
**/.git

# Local environment files and credentials must never enter a Docker context.
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.der
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa*
**/id_ed25519*

# Database exports and operator backups are not application source. Migration
# SQL remains included because its filenames do not match these dump patterns.
**/backup.sql
**/dump.sql
**/*-backup.sql
**/*_backup.sql
**/*-dump.sql
**/*_dump.sql
**/*.sql
!packages/db/migrations/**/*.sql
**/*.dump
**/*.dump.gz
**/*.sql.gz
**/*.sql.bz2
**/*.sql.xz
**/*.bak
**/*.backup
**/backups
**/backups/**
**/dumps
**/dumps/**

# Local caches, reports, and editor/OS artifacts.
**/coverage
**/playwright-report
**/test-results
**/.cache
**/.eslintcache
**/.pnpm-store
**/.vite
**/.history
**/.idea
**/.vscode
**/*.tsbuildinfo
**/*.swp
**/*.swo
**/*.tmp
**/*.temp
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
*.log
